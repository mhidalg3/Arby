# ===== Database =====
DATABASE_URL=postgresql+psycopg://arby:arby_dev_password@localhost:5433/arby
DATABASE_URL_SYNC=postgresql+psycopg2://arby:arby_dev_password@localhost:5433/arby

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== Anthropic =====
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Model selection per task. Haiku for high-volume cheap calls,
# Sonnet for partition validation where precision matters.
ANTHROPIC_MODEL_PARSER=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_VALIDATOR=claude-sonnet-4-6

# ===== Engine parameters =====
# Minimum margin (in pct) below which we ignore an opportunity even if math works
MIN_MARGIN_PCT_BASE=1.0

# GARCH multiplier sensitivity — higher = more conservative in volatile regimes
GARCH_SENSITIVITY=2.0

# Per-match and total exposure caps (in credit-currency units)
MAX_POSITION_PER_MATCH=500.0
MAX_TOTAL_EXPOSURE=2000.0
MAX_DAILY_LOSS=500.0

# Odds tolerance after Leg 1 fills. If actual filled odds deviate by more
# than this pct from expected, abort and log naked exposure.
ODDS_TOLERANCE_PCT=1.0

# ===== Logging =====
LOG_LEVEL=INFO
LOG_FORMAT=json

# ===== Platform login credentials =====
# NOT stored here. Sportsbook logins live in the OS keychain, not in this
# file (funded accounts → no plaintext secrets on disk). Manage them with:
#   uv run python -m src.credentials set <platform>      # betano|betsson|betwarrior|bplay
#   uv run python -m src.credentials status
# For logged-in *recon* you don't even need these — log in by hand once via
#   uv run python scripts/recon/recon.py --platform <p> --login --url <site>
# and the persistent browser profile keeps the session.
